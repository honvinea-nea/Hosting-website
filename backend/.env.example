NODE_ENV=development
PORT=3000
# Prefer `npm run setup` to generate private credentials in backend/.env.
# For manual setup, replace each blank value with your own private configuration.
DATABASE_URL=
PGSSLMODE=require
DB_POOL_SIZE=10
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_TOTP_ENCRYPTION_KEY=
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=
ABA_PAYWAY_MERCHANT_ID=
ABA_PAYWAY_API_KEY=
ABA_PAYWAY_ENV=sandbox
